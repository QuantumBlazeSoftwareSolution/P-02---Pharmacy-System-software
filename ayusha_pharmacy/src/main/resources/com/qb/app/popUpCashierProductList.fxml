<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.Group?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" fx:id="root" prefHeight="600.0" prefWidth="1000.0" styleClass="bg-primary-5" stylesheets="@css/style.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.qb.app.controllers.PopUpCashierProductListController">
   <children>
      <BorderPane layoutX="210.0" layoutY="243.0" prefHeight="200.0" prefWidth="200.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <top>
            <HBox alignment="CENTER" prefHeight="40.0" prefWidth="200.0" spacing="10.0" styleClass="bg-primary" stylesheets="@css/style.css" BorderPane.alignment="CENTER">
               <children>
                  <Group fx:id="pageIcon" />
                  <Label styleClass="primary-white" stylesheets="@css/style.css" text="Product List">
                     <font>
                        <Font name="System Bold" size="16.0" />
                     </font>
                  </Label>
                  <Pane HBox.hgrow="ALWAYS" />
                  <BorderPane minHeight="40.0" minWidth="40.0" onMouseClicked="#closePopUp" prefHeight="40.0" prefWidth="40.0" style="-fx-background-radius: 5px;" styleClass="close" stylesheets="@css/r.css">
                     <center>
                        <Group fx:id="closeIcon" BorderPane.alignment="CENTER" />
                     </center>
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                  </BorderPane>
               </children>
               <padding>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </padding>
            </HBox>
         </top>
         <center>
            <VBox prefHeight="200.0" prefWidth="100.0" stylesheets="@css/style.css" BorderPane.alignment="CENTER">
               <children>
                  <HBox prefWidth="200.0">
                     <children>
                        <VBox>
                           <children>
                              <Label styleClass="primary-text" stylesheets="@css/style.css" text="Search">
                                 <font>
                                    <Font size="14.0" />
                                 </font>
                              </Label>
                              <TextField fx:id="tfSearch" maxWidth="1.7976931348623157E308" onKeyReleased="#handleSearchKeyPressed" prefHeight="40.0" prefWidth="300.0" stylesheets="@css/style.css">
                                 <styleClass>
                                    <String fx:value="bg-white" />
                                    <String fx:value="primary-border-dash" />
                                    <String fx:value="bg-primary-5" />
                                    <String fx:value="textFieldColor" />
                                 </styleClass></TextField>
                           </children>
                        </VBox>
                        <Pane prefWidth="200.0" HBox.hgrow="ALWAYS" />
                        <VBox>
                           <children>
                              <Label styleClass="primary-text" stylesheets="@css/style.css" text="Filter By">
                                 <font>
                                    <Font size="14.0" />
                                 </font>
                              </Label>
                              <ComboBox fx:id="FilterBy" maxWidth="1.7976931348623157E308" onAction="#FilterByAction" prefHeight="40.0" prefWidth="300.0" stylesheets="@css/style.css">
                                 <styleClass>
                                    <String fx:value="primary-border" />
                                    <String fx:value="bg-primary-5" />
                                 </styleClass></ComboBox>
                           </children>
                        </VBox>
                     </children>
                     <VBox.margin>
                        <Insets bottom="10.0" right="20.0" />
                     </VBox.margin>
                  </HBox>
                  <TableView fx:id="table" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
                    <columns>
                      <TableColumn fx:id="colId" maxWidth="100.0" prefWidth="75.0" text="ID" />
                      <TableColumn fx:id="colProduct" prefWidth="75.0" text="Item Name" />
                        <TableColumn fx:id="colDepartment" prefWidth="75.0" text="Department" />
                        <TableColumn fx:id="colSalePrice" maxWidth="160.0" prefWidth="75.0" text="Sale Price" />
                        <TableColumn fx:id="colCostPrice" maxWidth="160.0" prefWidth="75.0" text="Cost Price" />
                        <TableColumn fx:id="colUnit" maxWidth="120.0" prefWidth="75.0" text="Unit" />
                        <TableColumn fx:id="colMeasure" maxWidth="120.0" prefWidth="75.0" text="Measure" />
                        <TableColumn fx:id="colDiscount" maxWidth="160.0" prefWidth="75.0" text="Discount" />
                        <TableColumn fx:id="colStatus" maxWidth="120.0" prefWidth="75.0" text="Status" />
                    </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
               </children>
               <BorderPane.margin>
                  <Insets />
               </BorderPane.margin>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </VBox>
         </center>
      </BorderPane>
   </children>
</AnchorPane>
