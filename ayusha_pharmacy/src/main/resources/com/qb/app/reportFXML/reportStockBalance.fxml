<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXToggleButton?>
<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.Group?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" fx:id="root" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="900.0" styleClass="primary-10" stylesheets="@../css/adminStyle.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.qb.app.controllers.report.ReportStockBalanceController">
   <children>
      <BorderPane prefHeight="200.0" prefWidth="200.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <top>
            <HBox alignment="CENTER_LEFT" spacing="10.0" BorderPane.alignment="CENTER">
               <children>
                  <Group fx:id="iconPage" />
                  <Label styleClass="primary-text" stylesheets="@../css/adminStyle.css" text="Stock Balance Report">
                     <font>
                        <Font size="16.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
         </top>
         <padding>
            <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
         </padding>
         <center>
            <VBox prefHeight="200.0" prefWidth="100.0" spacing="12.0" BorderPane.alignment="CENTER">
               <children>
                  <HBox spacing="12.0" VBox.vgrow="ALWAYS">
                     <children>
                        <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                           <children>
                              <VBox spacing="10.0">
                                 <children>
                                    <VBox alignment="TOP_RIGHT">
                                       <children>
                                          <HBox alignment="BOTTOM_LEFT" spacing="10.0">
                                             <children>
                                                <VBox alignment="CENTER_LEFT" layoutX="10.0" layoutY="10.0" maxWidth="220.0" minWidth="180.0" prefWidth="180.0">
                                                   <children>
                                                      <JFXToggleButton fx:id="CheckBox" onAction="#checkBoxAction" styleClass="text-field-label" stylesheets="@../css/adminStyle.css" text="View Full Stock" />
                                                   </children>
                                                </VBox>
                                                <Region HBox.hgrow="ALWAYS" />
                                                <VBox layoutX="10.0" layoutY="10.0" maxWidth="220.0" minWidth="180.0" prefWidth="180.0">
                                                   <children>
                                                      <Label styleClass="text-field-label" stylesheets="@../css/adminStyle.css" text="Department">
                                                         <font>
                                                            <Font size="14.0" />
                                                         </font>
                                                      </Label>
                                                      <ComboBox fx:id="cbBrand" maxWidth="1.7976931348623157E308" prefHeight="45.0" prefWidth="230.0" promptText="Select Department" stylesheets="@../css/adminStyle.css" />
                                                   </children>
                                                </VBox>
                                                <VBox maxWidth="220.0" minWidth="180.0" prefWidth="180.0">
                                                   <children>
                                                      <Label styleClass="text-field-label" stylesheets="@../css/adminStyle.css" text="Filter By">
                                                         <font>
                                                            <Font size="14.0" />
                                                         </font>
                                                      </Label>
                                                      <ComboBox fx:id="cbFilter" maxWidth="1.7976931348623157E308" prefHeight="45.0" prefWidth="230.0" stylesheets="@../css/adminStyle.css" />
                                                   </children>
                                                </VBox>
                                                <Button fx:id="LoadReport" maxWidth="200.0" minHeight="-Infinity" mnemonicParsing="false" onAction="#Loadreport" prefHeight="45.0" prefWidth="200.0" stylesheets="@../css/adminStyle.css" text="Load Report">
                                                   <styleClass>
                                                      <String fx:value="button-primary" />
                                                      <String fx:value="primary-white" />
                                                      <String fx:value="full-width-button" />
                                                   </styleClass>
                                                   <cursor>
                                                      <Cursor fx:constant="HAND" />
                                                   </cursor>
                                                </Button>
                                             </children>
                                          </HBox>
                                       </children>
                                    </VBox>
                                 </children>
                              </VBox>
                              <TableView fx:id="table" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
                                <columns>
                                  <TableColumn fx:id="colId" maxWidth="100.0" prefWidth="75.0" text="ID" />
                                  <TableColumn fx:id="colDepartment" maxWidth="250.0" prefWidth="75.0" text="Department" />
                                    <TableColumn fx:id="colItemName" prefWidth="75.0" text="Item Name" />
                                    <TableColumn fx:id="colQty" maxWidth="100.0" prefWidth="75.0" text="Qty" />
                                    <TableColumn fx:id="colCostPrice" maxWidth="160.0" prefWidth="75.0" text="Cost Price" />
                                    <TableColumn fx:id="colSalePrice" maxWidth="160.0" prefWidth="75.0" text="Sale Price" />
                                    <TableColumn fx:id="colProfit" maxWidth="160.0" prefWidth="75.0" text="Profit" />
                                </columns>
                                 <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                 </columnResizePolicy>
                              </TableView>
                              <VBox spacing="10.0">
                                 <children>
                                    <HBox alignment="BOTTOM_LEFT" spacing="10.0">
                                       <children>
                                          <VBox prefWidth="200.0">
                                             <children>
                                                <Label styleClass="text-field-label" stylesheets="@../css/adminStyle.css" text="Total Stock Value">
                                                   <font>
                                                      <Font size="14.0" />
                                                   </font>
                                                </Label>
                                                <TextField fx:id="TFTotalStockValue" editable="false" prefHeight="45.0" styleClass="text-field" stylesheets="@../css/adminStyle.css">
                                                   <font>
                                                      <Font size="14.0" />
                                                   </font>
                                                </TextField>
                                             </children>
                                          </VBox>
                                          <VBox layoutX="10.0" layoutY="10.0" prefWidth="200.0">
                                             <children>
                                                <Label styleClass="text-field-label" stylesheets="@../css/adminStyle.css" text="Total Sale Value">
                                                   <font>
                                                      <Font size="14.0" />
                                                   </font>
                                                </Label>
                                                <TextField fx:id="TFTotalSaleValue" editable="false" prefHeight="45.0" styleClass="text-field" stylesheets="@../css/adminStyle.css">
                                                   <font>
                                                      <Font size="14.0" />
                                                   </font>
                                                </TextField>
                                             </children>
                                          </VBox>
                                          <VBox prefWidth="200.0">
                                             <children>
                                                <Label styleClass="text-field-label" stylesheets="@../css/adminStyle.css" text="Total Profit">
                                                   <font>
                                                      <Font size="14.0" />
                                                   </font>
                                                </Label>
                                                <TextField fx:id="TFTotalProfit" editable="false" prefHeight="45.0" styleClass="text-field" stylesheets="@../css/adminStyle.css">
                                                   <font>
                                                      <Font size="14.0" />
                                                   </font>
                                                </TextField>
                                             </children>
                                          </VBox>
                                          <Region HBox.hgrow="ALWAYS" />
                                          <Button fx:id="btnRefresh" minHeight="-Infinity" mnemonicParsing="false" onAction="#Refresh" prefHeight="45.0" prefWidth="200.0" stylesheets="@../css/adminStyle.css" text="Refresh (F5)">
                                             <styleClass>
                                                <String fx:value="button-primary-outline" />
                                                <String fx:value="primary-white" />
                                                <String fx:value="full-width-button" />
                                             </styleClass>
                                             <cursor>
                                                <Cursor fx:constant="HAND" />
                                             </cursor>
                                          </Button>
                                          <Button fx:id="ViewReport" maxWidth="200.0" minHeight="-Infinity" mnemonicParsing="false" onAction="#viewReport" prefHeight="45.0" prefWidth="200.0" stylesheets="@../css/adminStyle.css" text="View Report">
                                             <styleClass>
                                                <String fx:value="button-primary" />
                                                <String fx:value="primary-white" />
                                                <String fx:value="full-width-button" />
                                             </styleClass>
                                             <cursor>
                                                <Cursor fx:constant="HAND" />
                                             </cursor>
                                          </Button>
                                       </children>
                                    </HBox>
                                 </children>
                              </VBox>
                           </children>
                        </VBox>
                     </children>
                  </HBox>
               </children>
               <padding>
                  <Insets left="50.0" right="50.0" />
               </padding>
               <BorderPane.margin>
                  <Insets top="20.0" />
               </BorderPane.margin>
            </VBox>
         </center>
      </BorderPane>
   </children>
</AnchorPane>
