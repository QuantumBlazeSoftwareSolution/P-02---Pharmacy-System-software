                  <Font size="14.0" />
               </font>
            </Label>
         </center>
      </BorderPane>
      <BorderPane maxWidth="150.0" minWidth="-Infinity" prefWidth="120.0" style="-fx-border-radius: 0px; -fx-border-width: 0.5px 0.5px 0.5px 0;" styleClass="primary-border" stylesheets="@../css/adminStyle.css" HBox.hgrow="ALWAYS">
         <center>
            <Label fx:id="InvoiceNumber" styleClass="primary-text" stylesheets="@../css/adminStyle.css" text="Invoice Number" BorderPane.alignment="CENTER">
               <font>
                  <Font size="14.0" />
               </font>
            </Label>
         </center>
      </BorderPane>
      <BorderPane minWidth="-Infinity" prefWidth="120.0" style="-fx-border-radius: 0px; -fx-border-width: 0.5px 0.5px 0.5px 0;" styleClass="primary-border" stylesheets="@../css/adminStyle.css" HBox.hgrow="ALWAYS">
         <center>
            <Label fx:id="ProductName" styleClass="primary-text" stylesheets="@../css/adminStyle.css" text="Product Name" BorderPane.alignment="CENTER">
